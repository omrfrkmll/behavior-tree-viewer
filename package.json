{
  "name": "groot2-viewer",
  "displayName": "groot2-viewer",
  "description": "A VS Code extension for viewing XML behavior trees.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:xml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "groot2-viewer.openPreview",
        "title": "Open Behavior Tree Preview",
        "icon": "$(preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "groot2-viewer.openPreview",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "groot2-viewer.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && resourceLangId == xml"
      }
    ]
  },
  "scripts": {
    "app:dev": "vite",
    "app:build": "vite build",
    "rust:build": "cargo build --workspace",
    "rust:test": "cargo test --workspace",
    "check": "pnpm run rust:test && pnpm run app:build && pnpm run compile",
    "precommit": "pnpm run check",
    "vscode:prepublish": "pnpm run app:build && pnpm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "~22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.140.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "ts-loader": "^9.6.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@types/d3": "^7.4.3",
    "@types/sax": "^1.2.7",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "d3": "^7.9.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.52.0",
    "process": "^0.11.10",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sax": "^1.6.1",
    "stream-browserify": "^3.0.0",
    "tailwind-merge": "^3.7.0"
  }
}