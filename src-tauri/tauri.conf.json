{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "behavior-tree-viewer",
  "version": "0.1.0",
  "identifier": "com.behaviortree.viewer",
  "build": {
    "frontendDist": "../dist-app",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm run app:dev",
    "beforeBuildCommand": "pnpm run app:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BehaviorTree Viewer Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
